# Copy this file to .env and adjust if needed. docker-compose and the
# migrate CLI both read these.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection string, derived from the values above. `sslmode=disable`
# is fine for local dev only; we do not ship this file with real credentials.
DATABASE_URL=postgres://booking:booking@localhost:5432/booking?sslmode=disable
